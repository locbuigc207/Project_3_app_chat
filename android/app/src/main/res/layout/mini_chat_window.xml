<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="320dp"
    android:layout_height="450dp"
    android:orientation="vertical"
    android:background="@drawable/mini_chat_background"
    android:elevation="16dp"
    android:clickable="true"
    android:focusable="true">

    <!-- HEADER WITH DRAG HANDLE -->
    <RelativeLayout
        android:id="@+id/mini_chat_header"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:background="@drawable/mini_chat_header_bg"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:elevation="4dp">

        <View
            android:id="@+id/drag_handle"
            android:layout_width="40dp"
            android:layout_height="4dp"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="2dp"
            android:background="@drawable/drag_handle"
            android:alpha="0.3" />

        <ImageView
            android:id="@+id/mini_chat_avatar"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_below="@id/drag_handle"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:layout_marginStart="8dp"
            android:layout_marginTop="6dp"
            android:scaleType="centerCrop"
            android:contentDescription="@string/user_avatar"
            android:background="@drawable/avatar_border" />

        <TextView
            android:id="@+id/mini_chat_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/drag_handle"
            android:layout_toEndOf="@id/mini_chat_avatar"
            android:layout_toStartOf="@id/mini_chat_actions"
            android:layout_centerVertical="true"
            android:layout_marginStart="12dp"
            android:layout_marginTop="6dp"
            android:text="@string/user_name_placeholder"
            android:textColor="@android:color/white"
            android:textSize="16sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />

        <!-- ✅ ADDED: Status text (optional, hidden by default) -->
        <TextView
            android:id="@+id/mini_chat_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/mini_chat_name"
            android:layout_toEndOf="@id/mini_chat_avatar"
            android:layout_marginStart="12dp"
            android:layout_marginTop="2dp"
            android:text="Online"
            android:textColor="#B3FFFFFF"
            android:textSize="11sp"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/mini_chat_actions"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/drag_handle"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:layout_marginTop="6dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/btn_minimize"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:padding="8dp"
                android:src="@drawable/ic_minimize"
                android:tint="@android:color/white"
                android:contentDescription="@string/minimize"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackgroundBorderless" />

            <ImageView
                android:id="@+id/btn_close"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginStart="4dp"
                android:padding="8dp"
                android:src="@drawable/ic_close"
                android:tint="@android:color/white"
                android:contentDescription="@string/close"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackgroundBorderless" />
        </LinearLayout>
    </RelativeLayout>

    <!-- MESSAGES CONTAINER WITH STATES -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@android:color/white">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/mini_chat_messages"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="8dp"
            android:clipToPadding="false"
            android:background="@android:color/white"
            android:scrollbars="vertical"
            android:fadeScrollbars="false"
            android:scrollbarStyle="outsideOverlay"
            android:overScrollMode="ifContentScrolls" />

        <!-- Loading State -->
        <ProgressBar
            android:id="@+id/mini_chat_loading"
            style="?android:attr/progressBarStyle"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="center"
            android:visibility="visible"
            android:indeterminate="true" />

        <!-- Empty State -->
        <LinearLayout
            android:id="@+id/mini_chat_empty_state"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:gravity="center"
            android:visibility="gone">

            <ImageView
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:src="@drawable/ic_chat_empty"
                android:alpha="0.3"
                android:contentDescription="@string/no_messages" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/no_messages_yet"
                android:textColor="#999999"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- Error State -->
        <LinearLayout
            android:id="@+id/mini_chat_error_state"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:gravity="center"
            android:visibility="gone">

            <ImageView
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:src="@drawable/ic_error"
                android:tint="#FF6B6B"
                android:contentDescription="@string/error" />

            <TextView
                android:id="@+id/mini_chat_error_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/failed_to_load_messages"
                android:textColor="#FF6B6B"
                android:textSize="14sp" />

            <Button
                android:id="@+id/btn_retry"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/retry"
                android:textColor="@android:color/white"
                android:background="@drawable/retry_button_bg"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp" />
        </LinearLayout>

        <!-- ✅ ADDED: New Message Indicator (shown when scrolled up) -->
        <TextView
            android:id="@+id/new_message_indicator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="60dp"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:background="@drawable/retry_button_bg"
            android:text="1 new message"
            android:textColor="@android:color/white"
            android:textSize="12sp"
            android:textStyle="bold"
            android:elevation="8dp"
            android:clickable="true"
            android:focusable="true"
            android:visibility="gone" />
    </FrameLayout>

    <!-- INPUT AREA WITH SEND LOADING -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@android:color/white"
        android:elevation="4dp">

        <!-- Typing Indicator (Hidden by default) -->
        <LinearLayout
            android:id="@+id/typing_indicator"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="8dp"
            android:gravity="center_vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/typing"
                android:textColor="#999999"
                android:textSize="12sp"
                android:textStyle="italic" />

            <ProgressBar
                style="?android:attr/progressBarStyleSmall"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginStart="8dp"
                android:indeterminate="true" />
        </LinearLayout>

        <!-- Input Container -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="8dp"
            android:background="#F5F5F5"
            android:gravity="center_vertical"
            android:minHeight="56dp">

            <EditText
                android:id="@+id/mini_chat_input"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="@string/type_message"
                android:background="@drawable/input_background"
                android:padding="12dp"
                android:maxLines="4"
                android:minLines="1"
                android:maxLength="1000"
                android:textSize="14sp"
                android:textColor="#333333"
                android:textColorHint="#999999"
                android:imeOptions="actionSend"
                android:inputType="textCapSentences|textMultiLine"
                android:scrollbars="vertical" />

            <FrameLayout
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="8dp">

                <ImageView
                    android:id="@+id/btn_send"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="10dp"
                    android:src="@drawable/ic_send"
                    android:tint="#2196F3"
                    android:contentDescription="@string/send"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?attr/selectableItemBackgroundBorderless" />

                <ProgressBar
                    android:id="@+id/send_loading"
                    style="?android:attr/progressBarStyleSmall"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:visibility="gone"
                    android:indeterminate="true" />
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>

</LinearLayout>